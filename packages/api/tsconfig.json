{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2023",
    "rootDir": ".",
    "outDir": "./dist",

    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "strictPropertyInitialization": false,

    "sourceMap": true,
    "incremental": true,
    "skipLibCheck": true,

    "baseUrl": ".",
    // "ignoreDeprecations": "6.0",

    "paths": {
      "@/*": ["src/*"],
      "@generated/*": ["generated/*"]
    }
  },
  "include": ["src", "generated"],
  "exclude": [
    "node_modules", 
    "dist",
    "src/dashboard/**",      
    "src/billing/**",    
    "src/ABC",
    "src/platform",
    "src/shared",
    "src/supabase",
    "src/storefront"
  ]
}
